{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crystal Quest Homework Pack v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "paragraphs",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "dueDate": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 0
    },
    "reviewRequired": {
      "const": false
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "mainIdea"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": [
              "string",
              "integer"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "mainIdea": {
            "$ref": "#/$defs/check"
          },
          "narration": {
            "type": "string"
          },
          "illustration": {
            "oneOf": [
              {
                "enum": [
                  "forest",
                  "garden",
                  "space",
                  "ocean"
                ]
              },
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "forest",
                      "garden",
                      "space",
                      "ocean"
                    ]
                  },
                  "alt": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "keywordGroups",
          "evidence",
          "hints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "keywordGroups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "any"
              ],
              "properties": {
                "any": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "paragraphId",
                "start",
                "end",
                "explanation"
              ],
              "properties": {
                "paragraphId": {
                  "type": "string"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          },
          "hints": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "regionHint": {
            "type": "string"
          },
          "rescue": {
            "type": "string"
          },
          "outline": {
            "type": "string"
          },
          "reflection": {
            "$ref": "#/$defs/check"
          },
          "evidenceGroups": {
            "description": "OR between groups, AND between evidence indices within a group. Absent means every individual evidence entry is an alternative (legacy packs).",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "worksheet": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "multiple_choice",
                  "short_answer",
                  "diagram_label",
                  "true_false"
                ]
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 4,
                "uniqueItems": true
              },
              "answer": {
                "type": "integer",
                "minimum": 0
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "minItems": 4,
                "maxItems": 4,
                "uniqueItems": true
              },
              "parentGuidance": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "prompt",
        "choices",
        "answer"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
